# Peptide Connect — build-time environment
#
# Public origin for canonical tags, Open Graph, Twitter cards, JSON-LD, and
# Astro's `site` option. Set this for a future domain transfer.
#
# Default when unset: https://peptide-connect.com
#
# Do NOT set this to localhost for production sharing.
PUBLIC_SITE_ORIGIN=https://peptide-connect.com
