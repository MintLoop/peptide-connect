---
// src/components/Nav.astro
// Public navigation. Admin is intentionally NOT linked (authenticated — see
// /admin, gated by a non-guessable token, handled by Phase C).
//
// Responsive: desktop = inline nav, hamburger hidden. Mobile (<=860px) = a
// slide-in drawer with a backdrop, X (morphed hamburger) to close, link-click +
// Escape + resize-to-desktop to close, aria-expanded/controls, and focus
// management. (M2 fix: the drawer previously carried an inline display:flex
// that defeated the fixed-drawer media query, and a duplicate display on the
// toggle kept the hamburger visible on desktop.)
import { site } from '../config/site';
import BrandMark from './BrandMark.astro';
---

<header class="nav">
   <nav class="nav__inner container" aria-label="Primary">
    <a class="nav__brand" href="/" aria-label={`${site.name} — home`}>
      <BrandMark variant="auto" size={28} label="" />
      <span class="nav__brand-name">{site.shortName}</span>
     </a>

     <div class="nav__right">
       <!-- Theme toggle. Two distinct, recognizable icons — a sun (light) and a
            moon (dark) — only one shows, driven by the real :root[data-theme].
            The accessible label names the NEXT action; JS keeps it + aria-pressed
            in sync on every toggle. -->
       <button class="theme-toggle" id="theme-toggle" type="button"
           aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode" data-theme-toggle>
            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4.2" fill="currentColor"/>
                <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="12" y1="1.5" x2="12" y2="4.3"/>
                    <line x1="12" y1="19.7" x2="12" y2="22.5"/>
                    <line x1="1.5" y1="12" x2="4.3" y2="12"/>
                    <line x1="19.7" y1="12" x2="22.5" y2="12"/>
                    <line x1="4.6" y1="4.6" x2="6.6" y2="6.6"/>
                    <line x1="17.4" y1="17.4" x2="19.4" y2="19.4"/>
                    <line x1="19.4" y1="4.6" x2="17.4" y2="6.6"/>
                    <line x1="6.6" y1="17.4" x2="4.6" y2="19.4"/>
                </g>
            </svg>
            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
        </button>

       <!-- Hamburger: mobile only -->
       <button class="nav__menu-toggle" id="nav-toggle" type="button"
        aria-expanded="false" aria-controls="nav-drawer"
        aria-label="Open navigation menu">
        <span></span><span></span><span></span>
       </button>

       <!-- Backdrop blocks background interaction while the drawer is open. -->
       <div class="nav__backdrop" id="nav-backdrop" data-nav-backdrop></div>

       <ul class="nav__list" id="nav-drawer" data-drawer aria-label="Primary mobile">
        {
         site.nav.map(item =>
         <li><a href={item.href} data-nav-link>{item.label}</a></li>
         )
        }
        <li><a class="btn btn--primary btn--sm nav__cta" href="/request">Request an order</a></li>
       </ul>
      </div>
     </nav>
    </header>

<style>
    .nav {
     position: sticky;
     top: 0;
     z-index: 30;
     background: var(--nav-bg);
     backdrop-filter: saturate(140%) blur(8px);
     border-bottom: 1px solid var(--nav-border);
    }
    .nav__inner {
     display: flex;
     align-items: center;
     justify-content: space-between;
     height: 64px;
    }
    .nav__brand {
     display: flex;
     align-items: center;
     gap: 0.55rem;
     text-decoration: none;
    }
    .nav__right { display: flex; align-items: center; gap: 0.5rem; }
    .nav__brand-name {
     font-weight: 800;
     color: var(--ink);
     font-size: 1.02rem;
     letter-spacing: -0.02em;
    }

    /* Theme toggle — always visible (light/dark switcher). */
    .theme-toggle {
     display: inline-flex;
     align-items: center;
     justify-content: center;
     width: 38px;
     height: 38px;
     border: 1px solid var(--line);
     border-radius: var(--radius);
     background: transparent;
     cursor: pointer;
     padding: 0;
     color: var(--ink);
     transition: border-color 0.15s var(--ease), color 0.15s var(--ease);
    }
    .theme-toggle:hover { border-color: var(--teal); color: var(--teal-strong); }
    .theme-toggle__icon {
     display: block;
     width: 18px;
     height: 18px;
     color: var(--ink);
    }
    /* Two distinct, recognizable icons (sun + moon). Only one shows, switched by
       the real :root[data-theme] so the icon always matches the actual theme.
       No opacity/transform transition on the swap, so the active icon stays crisp */
    .theme-toggle__icon--sun { color: #E07A5F; }   /* warm sun on the light nav */
    .theme-toggle__icon--moon {
     color: #F7F9FA;        /* pale crescent on the dark navy nav   */
     display: none;
    }
    :root[data-theme="dark"] .theme-toggle__icon--sun { display: none; }
    :root[data-theme="dark"] .theme-toggle__icon--moon { display: block; }
    /* Keep a visible keyboard focus indicator on the always-present toggle. */
    .theme-toggle:focus-visible { outline: none; box-shadow: var(--ring); }

    /* ---- Desktop nav (inline) ---- */
    .nav__list {
     display: flex;
     gap: var(--space-4);
     list-style: none;
     align-items: center;
     margin: 0;
     padding: 0;
    }
    .nav__list a[data-nav-link] {
     color: var(--ink-2);
     font-weight: 600;
     font-size: var(--fs-sm);
     padding: 0.4rem 0;
     position: relative;
     text-decoration: none;
    }
    .nav__list a[data-nav-link]:hover { color: var(--teal-strong); }
    .nav__list a[data-current] { color: var(--ink); font-weight: 700; }
    .nav__list a[data-current]::after {
     content: '';
     position: absolute;
     left: 0;
     right: 0;
     bottom: -2px;
     height: 2px;
     background: var(--teal);
     border-radius: 2px;
    }

        /* Hamburger: hidden on desktop, shown in the 860px media query below. */
    .nav__menu-toggle {
     display: none;
     background: transparent;
     border: 1px solid var(--line);
     border-radius: var(--radius);
     width: 42px;
     height: 42px;
     flex-direction: column;
     align-items: center;
     justify-content: center;
     gap: 4px;
     cursor: pointer;
     padding: 0;
    }
    .nav__menu-toggle span {
     display: block;
     width: 20px;
     height: 2px;
     background: var(--ink);
     border-radius: 2px;
     transition: transform 0.18s var(--ease), opacity 0.18s var(--ease);
    }
    .nav__menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav__menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .nav__menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

        /* Backdrop — blocks background scrolling/interaction while open. Token-driven. */
    .nav__backdrop {
     position: fixed;
     inset: 64px 0 0 0;
     background: rgba(16, 45, 56, 0.45);
     z-index: 25;
     opacity: 0;
     visibility: hidden;
     transition: opacity 0.18s var(--ease), visibility 0.18s var(--ease);
    }
    .nav__backdrop[data-open] { opacity: 1; visibility: visible; }

        /* ---- Mobile drawer ---- */
    .nav__menu-toggle:focus-visible { outline: none; box-shadow: var(--ring); }
    @media (max-width: 860px) {
     .nav__menu-toggle { display: inline-flex; }
     .nav__list {
     position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      z-index: 30;
      background: var(--surface);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-4) var(--gutter) var(--space-5);
      max-height: calc(100vh - 64px);
      overflow-y: auto;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-md);
      transform: translateY(-12px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.18s var(--ease), opacity 0.18s var(--ease), visibility 0.18s var(--ease);
     }
     .nav__list[data-open] {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
     }
     .nav__list li {
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--line-soft);
     }
     .nav__list li:last-child {
      border-bottom: none;
      padding-top: var(--space-4);
     }
     .nav__list a[data-nav-link] {
      color: var(--navy);
      font-size: var(--fs-base);
     }
     .nav__list a[data-nav-link]:focus-visible {
      outline: none;
      box-shadow: var(--ring);
      border-radius: var(--radius-sm);
     }
     .nav__cta { width: 100%; }
    }
</style>
