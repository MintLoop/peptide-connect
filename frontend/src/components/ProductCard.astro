---
// src/components/ProductCard.astro
// A catalog card. DEMO-safe: never shows a real purity/COA claim. The
// "COA available" badge only renders when coaAvailable is true (always false in
// the DEMO data — honest empty state).
import type { Product } from '../data/catalog';
import StatusBadge from './StatusBadge.astro';

interface Props { product: Product }
const { product } = Astro.props;
---
<article class="card product-card"
   data-product-card
   data-name={product.name}
   data-compound={product.compound}
   data-family={product.family}
   data-status={product.status}
   style="display:flex;flex-direction:column;gap:var(--space-3);">
    <div class="flex justify-between items-center">
      <StatusBadge status={product.status} />
      {product.coaAvailable
        ? <span class="badge badge--available">COA on file</span>
        : <span class="badge badge--demo" title="No COA published for this lot">No COA</span>}
    </div>

    <h3 style="margin:0;font-size:var(--fs-md);">
      <a href={`/catalog/${product.slug}`} style="color:inherit;text-decoration:none;">
        {product.name}
      </a>
    </h3>

    <p class="muted" style="font-size:var(--fs-sm);margin:0;">
      <span class="mono">{product.compound}</span>
    </p>

    <dl style="display:grid;grid-template-columns:auto 1fr;gap:.35rem 1rem;
              font-size:var(--fs-sm);margin:0;">
      <dt class="muted-strong">Family</dt><dd style="margin:0;">{product.family}</dd>
      <dt class="muted-strong">Form</dt><dd style="margin:0;">{product.form}</dd>
      <dt class="muted-strong">Route</dt><dd style="margin:0;">{product.route}</dd>
     </dl>

    <div class="flex flex-wrap gap-2" style="margin-top:auto;padding-top:var(--space-3);">
     {product.variants.map(v =>
        <span class="badge badge--demo" style="text-transform:none;">{v.label}</span>
      )}
    </div>

    <p class="muted" style="font-size:var(--fs-xs);">
      {product.draftFlag ? 'Draft · pending owner review. ' : ''}
     Research use only. Not for human or veterinary consumption.
    </p>

    <div class="flex gap-2" style="margin-top:var(--space-2);align-items:center;">
       <a class="btn btn--ghost btn--sm" href={`/catalog/${product.slug}`}>
        View details
       </a>
      {product.status !== 'not_available'
       ? <a class="btn btn--primary btn--sm" href={`/request?product=${product.slug}`}>Request</a>
        : <span class="badge badge--not-available" aria-disabled="true" style="cursor:not-allowed;align-self:center;">Unavailable</span>}
     </div>
    </article>
