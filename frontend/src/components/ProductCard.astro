---
// src/components/ProductCard.astro
// A catalog card (B.3.2). Hierarchy: name dominant, a neutral chemical
// descriptor beneath it, a compact spec block, one clear price line, and just
// two meaningful status badges (availability + documentation). The old variant
// "pills" became one tidy variant/price row. The client filter reads
// data-name/compound/family/status, so those attributes are preserved exactly.
// No fabricated COA/purity/claims; COA state is an honest empty/pending badge.
import type { Product } from '../data/catalog';
import { priceRange } from '../data/catalog';
import StatusBadge from './StatusBadge.astro';
import DocumentationBadge from './DocumentationBadge.astro';

interface Props { product: Product }
const { product } = Astro.props;
const { min, max } = priceRange(product);
const priceText = min === max ? `$${min}` : `From $${min}`;
const priceSpread = min === max ? '' : `$${min}–$${max}`;
const sizeText = product.variants.map(v => v.label).join(' · ');
---
<article class="card product-card"
   data-product-card
   data-name={product.name}
   data-compound={product.compound}
   data-family={product.family}
   data-status={product.status}>
   <div class="pcard__head">
     <StatusBadge status={product.status} />
     <DocumentationBadge state={product.documentation} />
   </div>

   <h3 class="pcard__name">
     <a href={`/catalog/${product.slug}`} aria-label={`${product.name} — view details`}>
       {product.name}
     </a>
   </h3>

   <p class="pcard__compound">{product.compound}</p>

   <dl class="pcard__specs">
     <dt>Family</dt><dd>{product.family}</dd>
     <dt>Form</dt><dd>{product.form}</dd>
     <dt>Route</dt><dd>{product.route}</dd>
     <dt>Sizes</dt><dd>{sizeText}</dd>
   </dl>

   {
   product.draftFlag && <p class="pcard__draft">Draft · pending owner review</p>
   }

   <div class="pcard__price">
     <span class="pcard__amount">{priceText}</span>
     {priceSpread && <span class="pcard__from">{priceSpread}</span>}
     <span class="pcard__ship">shipping included</span>
   </div>

   <div class="pcard__actions">
     <a class="btn btn--ghost btn--sm" href={`/catalog/${product.slug}`}>
       View details
     </a>
     {
     product.status !== 'not_available'
         ? <a class="btn btn--primary btn--sm" href={`/request?product=${product.slug}`}>Request</a>
         : <span class="badge badge--not-available" aria-disabled="true">Unavailable</span>
     }
   </div>

   <p class="pcard__note">
     Research use only. Not for human or veterinary consumption.
   </p>
 </article>

<style>
 .product-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  height: 100%;
 }
 .pcard__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  flex-wrap: wrap;
 }
 .pcard__name {
  margin: 0;
  font-size: var(--fs-lg);
  line-height: 1.1;
  font-weight: 800;
 }
 .pcard__name a { color: inherit; text-decoration: none; }
 .pcard__name a:hover { color: var(--teal-strong); }
 .pcard__compound {
  margin: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  color: var(--muted);
  letter-spacing: -0.01em;
 }
 .pcard__specs {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.3rem 0.9rem;
  margin: var(--space-2) 0 0;
  font-size: var(--fs-sm);
  border-top: 1px solid var(--line-soft);
  padding-top: var(--space-3);
 }
 .pcard__specs dt { color: var(--muted); font-weight: 600; }
 .pcard__specs dd { margin: 0; color: var(--ink-2); }
 .pcard__draft {
  margin: 0;
  font-size: var(--fs-xs);
  color: var(--warn);
  font-weight: 600;
 }
 .pcard__price {
  display: flex;
  align-items: baseline;
  gap: 0.4rem;
  flex-wrap: wrap;
  margin-top: auto;
  padding-top: var(--space-3);
 }
 .pcard__amount { font-size: var(--fs-md); font-weight: 800; color: var(--ink); }
 .pcard__from { font-size: var(--fs-xs); color: var(--muted); font-family: var(--font-mono); }
 .pcard__ship { font-size: var(--fs-xs); color: var(--muted); }
 .pcard__actions {
  display: flex;
  gap: var(--space-2);
  align-items: center;
  margin-top: var(--space-3);
 }
 .pcard__note {
  margin: var(--space-2) 0 0;
  font-size: var(--fs-xs);
  color: var(--muted);
 }
</style>
