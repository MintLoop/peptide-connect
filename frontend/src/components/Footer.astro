---
// src/components/Footer.astro
// Public footer. Admin is intentionally NOT linked from the public footer
// (authenticated — the /admin route is gated by a non-guessable URL token,
// handled by Phase C). Legal, company, and product links use centralized
// config.

import { site, DEMO } from '../config/site';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
---

<footer class="footer" style="
   background: var(--navy);
   color: var(--on-dark);
   padding: var(--space-8) 0 var(--space-6);
   margin-top: var(--space-8);
">
 <div class="container">
   <div class="footer__grid">
   <!-- Brand + tagline -->
  <div>
    <a class="footer__brand-link" href="/"
      style="display:flex;align-items:center;gap:.6rem;color:inherit;text-decoration:none;">
      <BrandMark variant="reversed" size={30} label="" />
      <span style="font-weight:800;font-size:1.05rem;">{site.shortName}</span>
    </a>
    <p class="muted" style="max-width:32ch;color:var(--on-dark-muted);
        font-size:var(--fs-sm);margin-top:var(--space-3);">
      {site.tagline}
    </p>
  </div>

  <!-- Link columns from config -->
  {
    site.footerNav.map(col =>
      <div class="footer__col">
        <h3
          style="color:var(--on-dark);font-size:var(--fs-xs);
            text-transform:uppercase;letter-spacing:.1em;margin-bottom:.75rem;"
        >
          {col.title}
        </h3>
        <ul style="list-style:none;padding:0;margin:0;
            display:flex;flex-direction:column;gap:.5rem;">
         {
           col.links.map(l =>
             <li><a
               href={l.href}
               style="color:var(--on-dark-muted);font-size:var(--fs-sm);"
               onmouseover="this.style.color='var(--teal-soft)'"
               onmouseout="this.style.color='var(--on-dark-muted)'"
             >{l.label}</a></li>
           )
         }
        </ul>
      </div>
    )
  }
 </div>

  <div class="divider" style="
     background: rgba(255,255,255,0.08);
     border:none;
     margin: var(--space-6) 0 var(--space-4);
  " />

  <div style="display:flex;flex-wrap:wrap;gap:var(--space-4);
               justify-content:space-between;align-items:center;
               font-size:var(--fs-xs);color:var(--on-dark-muted);">
    <p style="margin:0;">
      &copy; {year} {site.legal.entity}. All rights reserved.
    </p>
    <p style="margin:0;">
      Research use only — {DEMO ? 'DEMO build.' : ''}
    </p>
  </div>
 </div>
</footer>

<style>
   .footer__grid {
     display: grid;
     gap: var(--space-6);
     grid-template-columns: 1.4fr repeat(3, 1fr);
    }
    @media (max-width: 760px) {
      .footer__grid { grid-template-columns: 1fr 1fr; }
      .footer__brand-link { grid-column: 1 / -1; }
    }
    @media (max-width: 480px) {
      .footer__grid { grid-template-columns: 1fr; }
    }
</style>
