---
// /coa — permanent client-side redirect to /documentation.
// Canonical points at the production origin so shared links and SEO land correctly.
import { SITE_ORIGIN } from '../config/origin';

const canonical = `${SITE_ORIGIN}/documentation`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>COA Explorer</title>
<meta http-equiv="refresh" content="0;url=/documentation" />
<link rel="canonical" href={canonical} />
</head>
<body>
<p>
    <a href="/documentation">COA Explorer</a>
  has been moved to <a href="/documentation">Documentation</a>.
</p>
</body>
</html>