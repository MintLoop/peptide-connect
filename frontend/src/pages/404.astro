---
// Custom 404. Keep the shell + honest messaging.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Page not found" noIndex>
 <section class="section" style="padding-block:var(--space-9);">
   <div class="container container--narrow center">
    <PageHeader
     eyebrow="404"
     title="Page not found"
     lead="The page you're looking for doesn't exist or has moved."
     center
     uncontainer />
    <a class="btn btn--primary" href="/">Back to home</a>
    <a class="btn btn--ghost" href="/catalog">Browse catalog</a>
   </div>
 </section>
</Base>
