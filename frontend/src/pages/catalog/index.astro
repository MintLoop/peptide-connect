---
// src/pages/catalog/index.astro — Searchable, filterable catalog.
// Owner-supplied catalog data, clearly labeled. Client-side progressive
// enhancement (app.js reads #catalog-filter / #catalog-grid / data-* attrs —
// those IDs and attributes are preserved so the existing filter behavior holds).
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, allFamilies, CATALOG_META } from '../../data/catalog';

const families = allFamilies();
---
<Base title="Catalog">
 <PageHeader
   eyebrow="Catalog · Journey 1"
   title="Research compound catalog"
   lead="Discover research materials and their product information, then submit an inquiry. Prices are owner-supplied and include shipping; every certificate of analysis is shown as an honest empty or pending state — no purity or testing is fabricated." />

 <section class="section section--tight">
    <div class="container">

      <div class="callout callout--demo" style="margin-bottom:var(--space-6);">
        <div class="callout__title">
         <span class="badge badge--demo">DEMO</span> Catalog · {CATALOG_META.total} compounds
        </div>
        <p style="margin:0;">{CATALOG_META.note} {CATALOG_META.pricing} '\
        'Data dated {CATALOG_META.dataDate}.</p>
      </div>

      <!-- Filter bar — client filter reads these IDs/attrs, kept intact -->
      <div id="catalog-filter"
        class="card"
        style="
          display:grid;gap:var(--space-4);margin-bottom:var(--space-6);
          grid-template-columns:2fr 1fr 1fr;
         "
        data-filter>
        <div class="field" style="margin:0;">
          <label for="catalog-search">Search</label>
          <input id="catalog-search" type="search"
            placeholder="Search by name or compound…"
            autocomplete="off" />
        </div>
        <div class="field" style="margin:0;">
          <label for="catalog-family">Family</label>
          <select id="catalog-family">
           <option value="">All families</option>
           {
            families.map(f => <option value={f}>{f}</option>)
           }
         </select>
        </div>
        <div class="field" style="margin:0;">
          <label for="catalog-status">Availability</label>
          <select id="catalog-status">
           <option value="">All</option>
           <option value="available">Available</option>
           <option value="inquire">Inquire</option>
           <option value="not_available">Not available</option>
          </select>
        </div>
      </div>

      <div id="catalog-grid-wrap">
        <div id="catalog-grid" class="grid grid--3">
          {
           PRODUCTS.map(p => <ProductCard product={p} />)
          }
        </div>
      </div>

      <p id="catalog-empty"
        class="empty"
        style="margin-top:var(--space-6);display:none;">
        <h3>No products match your filters</h3>
        <p>
        Clear the filters or adjust your search. '\
        '<a href="/catalog">Reset the filters</a> to see every compound.</p>
      </p>
    </div>
 </section>
</Base>

<style>
      @media (max-width: 860px) {
       #catalog-filter { grid-template-columns: 1fr; }
      }
</style>
